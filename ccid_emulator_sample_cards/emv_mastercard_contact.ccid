# EMV Contact Payment Card (Mastercard) — CCID Emulator profile
#
# Emulates a CONTACT EMV card's PSE-based application selection as seen by a
# PC/SC reader talking to the Flipper's emulated USB CCID card. Complements the
# contactless Visa profile (which uses PPSE / 2PAY.SYS.DDF01).
#
# Uses the real Mastercard AID (A0000000041010) and the PSE directory name
# 1PAY.SYS.DDF01; all account data is EMV test data, not a real card.
#
# Source: openscdp.org EMV tutorial; EMV Book 1 application-selection flow.
# Copy to /ext/ccid_emulator/cards/ on your Flipper Zero SD card.

[card]
name = EMV Mastercard (Contact)
description = Contact Mastercard, PSE directory + AID select + GPO
atr = 3B 6E 00 00 80 31 80 66 B0 84 0C 01 6E 01 83 00 90 00

[rules]
# SELECT PSE — 1PAY.SYS.DDF01 (contact entry point)
00 A4 04 00 0E 31 50 41 59 2E 53 59 53 2E 44 44 46 30 31 = 6F 20 84 0E 31 50 41 59 2E 53 59 53 2E 44 44 46 30 31 A5 0E 88 01 01 5F 2D 04 65 6E 66 72 9F 11 01 01 90 00

# READ RECORD of the PSE directory (SFI 1, record 1) — lists the Mastercard AID
00 B2 01 0C 00 = 70 15 61 13 4F 07 A0 00 00 00 04 10 10 50 0A 4D 61 73 74 65 72 43 61 72 64 90 00

# SELECT Mastercard application (AID A0000000041010)
00 A4 04 00 07 A0 00 00 00 04 10 10 = 6F 20 84 07 A0 00 00 00 04 10 10 A5 15 50 0A 4D 61 73 74 65 72 43 61 72 64 87 01 01 9F 38 03 9F 1A 02 90 00

# GET PROCESSING OPTIONS (empty PDOL) — AIP + AFL
80 A8 00 00 02 83 00 = 77 0E 82 02 39 00 94 08 10 01 01 01 18 01 02 00 90 00

# READ RECORD — application record (wildcard on P1/P2)
00 B2 ?? ?? 00 = 70 13 5A 08 55 55 55 55 55 55 55 55 5F 24 03 29 12 31 5F 34 01 01 90 00

# GET DATA — PIN Try Counter (9F17)
80 CA 9F 17 00 = 9F 17 01 03 90 00

[default]
response = 6A 82
