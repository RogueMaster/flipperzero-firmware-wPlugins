Import("env")

env.Append(
    CPPPATH=[
        "#/lib/mjs",
    ],
    SDK_HEADERS=[
        File("mjs_core_public.h"),
        File("mjs_exec_public.h"),
        File("mjs_object_public.h"),
        File("mjs_string_public.h"),
        File("mjs_array_public.h"),
        File("mjs_primitive_public.h"),
        File("mjs_util_public.h"),
        File("mjs_array_buf_public.h"),
    ],
)

libenv = env.Clone(FW_LIB_NAME="mjs")
libenv.ApplyLibFlags()

libenv.AppendUnique(
    CCFLAGS=[
        "-Wno-redundant-decls",
        "-Wno-unused-function",
    ],
)

sources = libenv.GlobRecursive("*.c*", exclude=["fal"])

# Keep the complete native engine archive for the FAL and self-linked FAPs.
lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)

if env["IS_BASE_FIRMWARE"]:
    # The firmware links only this compatibility bridge. The existing mjs LTO
    # selection now applies to the bridge, never to the external native engine.
    bridgeenv = libenv.Clone(FW_LIB_NAME="mjs_fal", FW_LIB_LTO_NAME="mjs")
    bridgeenv.BuildFirmwareLibrary(Glob("fal/*.c"))
Return("lib")
