CompileFlags:
    Add: 
        - --include-directory=/Users/mbirth/.ufbt/current/sdk_headers/f7_sdk/furi
        - --include-directory=/Users/mbirth/.ufbt/current/sdk_headers/f7_sdk/lib/cmsis_core
        - --include-directory=/Users/mbirth/.ufbt/current/sdk_headers/f7_sdk/lib/mlib
        - --include-directory=/Users/mbirth/.ufbt/current/sdk_headers/f7_sdk/targets/f7/inc
        - --include-directory=/Users/mbirth/.ufbt/current/sdk_headers/f7_sdk/lib
        - --include-directory=/Users/mbirth/.ufbt/current/sdk_headers/f7_sdk/applications/services
        - -Wno-unknown-warning-option
        - -Wno-format
    Remove: 
        - -mword-relocations

Diagnostics:
    ClangTidy:
        FastCheckFilter: None

---

If:
    PathMatch: .*\.h
Diagnostics:
    UnusedIncludes: None
