*.fap

# ESP build output
esp32/hotspot-arcade-fw/build/
esp32/hotspot-arcade-fw/build-wroom/

# Bundled ESP firmware images: these ARE committed so the app-catalog build
# (bare ufbt at a commit) ships a working on-device flasher. Regenerate them
# with tools/build-fap.sh whenever the ESP firmware changes, and re-commit.

# Web build output is committed on release, but ignore local node cruft
web/node_modules/

# Python
__pycache__/
*.pyc

# ufbt
.ufbt/

# OS
.DS_Store

# Local dev notes (not committed)
CLAUDE.md

# ufbt-installed clang-format config (regenerated by `ufbt format`/`lint`)
flipper/hotspot-arcade/.clang-format
.superpowers/
.playwright-mcp/

# Planning docs from the superpowers workflow are kept locally, not committed.
docs/superpowers/

# Local Claude Code session data (worktrees, skills, memory) — never committed
.claude/
.gstack/
