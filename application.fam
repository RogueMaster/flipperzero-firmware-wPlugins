# Flipcraft is split into three pieces so only what is needed sits in RAM
# (FAP code is executed from RAM on this platform):
#   flipcraft          -- tiny resident host bridge, swaps the plugins below
#   flipcraft_menu     -- world selector UI, mapped only while the menu is open
#   flipcraft_game     -- game logic + renderer, mapped only during a session
#   flipcraft_worldgen -- terrain generator, mapped only while creating a world
# The plugins are embedded into the FAP and unpacked to
# /ext/apps_assets/flipcraft/plugins/ on first launch.
App(
    appid="flipcraft",
    name="Flipcraft",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipcraft_app",
    requires=["gui", "storage"],
    sources=["main.cpp"],
    stack_size=8 * 1024,
    fap_category="Games",
    fap_file_assets="assets/worlds",
    fap_icon="assets/icon.png",
    fap_author="@apfxtech",
    fap_version="2.2",
    fap_weburl="https://github.com/apfxtech/Flipcraft.git",
)

App(
    appid="flipcraft_menu",
    apptype=FlipperAppType.PLUGIN,
    entry_point="flipcraft_menu_ep",
    requires=["flipcraft"],
    sources=["menu/menu.cpp"],
    fal_embedded=True,
)

App(
    appid="flipcraft_worldgen",
    apptype=FlipperAppType.PLUGIN,
    entry_point="flipcraft_worldgen_ep",
    requires=["flipcraft"],
    sources=["worldgen/worldgen.cpp"],
    fal_embedded=True,
)

App(
    appid="flipcraft_game",
    apptype=FlipperAppType.PLUGIN,
    entry_point="flipcraft_game_ep",
    requires=["flipcraft"],
    sources=[
        "platform/f7fz/platform.cpp",
        "game/game.cpp",
        "game/data.cpp",
        "game/world.cpp",
        "render/render.cpp",
        "render/gui.cpp",
    ],
    fal_embedded=True,
)
