App(
    appid="internet_time_screen",
    name="Internet Time",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="internet_time_screen_app",
    stack_size=2 * 1024,
    fap_category="Tools",
    fap_version=(0, 1),
    fap_icon="assets/10x10.png",
    fap_description="Swatch Internet Time (@beats) and local clock",
    fap_author="inernet-time-screen",
    sources=[
        "*.c*",
        "!tests",
        "!tests/*",
    ],
)
