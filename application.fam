App(
    appid="microcity",
    name="MicroCity",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="microcity_app",
    requires=["gui"],
    sources=[
        "game/main.cpp",
        "game/Building.cpp",
        "game/Connectivity.cpp",
        "game/Draw.cpp",
        "game/Font.cpp",
        "game/Game.cpp",
        "game/Interface.cpp",
        "game/Simulation.cpp",
        "game/Strings.cpp",
        "game/Terrain.cpp",
    ],
    stack_size=4 * 1024,
    fap_category="Games",
    fap_icon=".catalog/icon_10px.png",
    fap_author="@apfxtech",
    fap_weburl="https://github.com/apfxtech/FlipperMicroCity.git",
    fap_version="2.0",
    fap_description="City building simulation ported from Arduboy.",
)
