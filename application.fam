App(
    appid="nfc_tools",
    name="NFC Tools",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nfc_tools_app",
    targets=["f7"],
    requires=["gui"],
    stack_size=4 * 1024,
    fap_category="NFC",
    fap_version=(1, 2),
    fap_icon="icons/icon.png",
    sources=[
        "core/*.c",
        "scenes/*.c",
        "scenes/write/*.c",
        "scenes/other/*.c",
        "scenes/read/*.c",
        "helpers/qrcode/*.c",
        "views/keyboard/*.c",
        "views/email_input/*.c",
        "views/mime_input/*.c",
        "views/special_input/*.c",
        "helpers/md5/*.c",
    ],
)
