App(
    appid="flauncher",
    name="Fav Launcher",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flauncher_app",
    stack_size=4 * 1024,
    fap_category="Tools",
    fap_icon="flauncher.png",
    fap_version="0.4",
    fap_author="tbelbek",
    fap_description="2x5 icon-grid launcher for favorites; long-press OK to pick an icon on-device; returns to the grid after use",
    requires=["gui", "storage", "loader"],
)
