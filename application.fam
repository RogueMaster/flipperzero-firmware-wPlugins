App(
    appid="mtools",
    name="MTools",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="mtools_app",
    sources=[
        "mtools_app.c",
        "features/about_ndef.c",
        "features/magic_check.c",
        "features/uid_changer.c",
        "nfc/card_info.c",
        "nfc/card_reader.c",
        "nfc/magic_detector.c",
        "nfc/magic_writer.c",
        "ui/mtools_ui.c",
        "ui/nfc_scan_art.c",
        "ui/uid_changer_ui.c",
    ],
    requires=["gui"],
    stack_size=4096,
    fap_category="NFC",
    fap_icon="mtools_icon.png",
    fap_icon_assets="images",
    fap_description="Magic tag tools for MIFARE Classic and ISO15693",
    fap_version="0.1",
)
