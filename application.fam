App(
    appid="fmtx",
    name="FM TX",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_zero_fmtx_app",
    requires=["gui", "storage"],
    stack_size=4 * 1024,
    order=10,
    fap_category="Sub-GHz",
    sources=["src/*.c"],
