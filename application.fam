App(
    appid="stratahero",
    name="Stratagem Hero",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="stratahero_main",
    stack_size=2 * 1024,
    fap_category="Games",
    fap_version="1.0",
    fap_icon="stratahero.png",  # 10x10 1-bit PNG
    fap_description="Helldivers 2 Stratagem Hero game for Flipper Zero",
    fap_author="Maxim Kulkin",
    fap_weburl="https://github.com/maximkulkin/flipper-zero-stratagem-hero",
    fap_icon_assets="images",  # Image assets to compile for this application
)
