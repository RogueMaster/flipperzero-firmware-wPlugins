# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="flipflash",  # Must be unique
    name="FlipFlash",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipflash",
    stack_size=8 * 1024,
    fap_category="Tools",
    # Optional values
    fap_version="1.0",
    fap_icon="icon.png",  # 10x10 1-bit PNG
    fap_description="A Flipper Zero flashcard app", 
    fap_author="Mushi0",
    fap_weburl="https://github.com/Mushi0/FlippFlash",
)
