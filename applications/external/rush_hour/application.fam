App(
    appid="flipper_tutu",
    name="Tutu",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tutu_app_entry",
    stack_size=3 * 1024,
    fap_category="Games",
    fap_icon="icons/icon.icon",
    fap_version="0.1.4",  # x-release-please-version
    fap_author="Endika",
    fap_description="Sliding car puzzle (Rush Hour) with 100 levels of increasing difficulty.",
    requires=["gui", "storage"],
    sources=[
        "main.c",
        "src/domain/board.c",
        "src/data/levels.c",
        "src/persistence/progress.c",
        "src/platform/storage_port.c",
        "src/app/tutu_app.c",
    ],
)
