App(
    appid="pc_health_remote",
    name="PC Health Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pc_health_remote_app",
    stack_size=6 * 1024,
    sources=["*.c", "!tests"],
    fap_icon="icon.png",
    fap_category="Bluetooth",
    fap_author="vladatman",
    fap_weburl="https://github.com/vladatman/pc-health-remote",
    fap_version="1.1",
    fap_description="PC temperatures & load on your Flipper, with vibro/sound alerts and tips",
)
