App(
    appid="nfc_stock_manager",
    name="NFC Stock Manager",
    apptype=FlipperAppType.EXTERNAL,
    sources=[
        "main.c",
        "src/scenes.c",
        "src/domain/stock.c",
        "src/domain/store_status.c",
        "src/domain/stock_recovery.c",
        "src/persistence/stock_file.c",
        "src/persistence/db.c",
        "src/persistence/fs_compat.c",
        "src/persistence/export.c",
        "src/platform/storage_helper.c",
        "src/ui/ui.c",
    ],
    entry_point="nfc_stock_app",
    stack_size=8 * 1024,
    targets=["f7"],
    fap_icon="icons/icon.icon",
    fap_category="NFC",
    fap_author="Endika",
    fap_weburl="https://github.com/Endika/flipper-nfc-stock",
    fap_version="0.1.7",
    fap_description="Manage inventory items via NFC tags",
)
