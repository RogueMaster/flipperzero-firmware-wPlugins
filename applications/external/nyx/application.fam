App(
    appid="nyx",
    name="Nyx",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="nyx_app",
    stack_size=4 * 1024,
    fap_icon="icons/nyx_10px.png",
    fap_icon_assets="icons",
    fap_category="Infrared",
    fap_author="at0m-b0mb",
    fap_weburl="https://github.com/at0m-b0mb/Nyx-FlipperZero",
    fap_version="1.1",
    fap_description="Infrared emitter sweep for counter-surveillance. Covert night-vision cameras light the room with 850/940 nm IR you cannot see - Nyx turns that giveaway into a meter you can walk around a hotel room or Airbnb. Onboard mode uses the built-in TSOP demodulator to find PULSED IR sources; because that part band-passes 38 kHz it is deaf to steady illuminators, so clipping a $1 IR phototransistor onto an ADC pin unlocks Probe mode, which reads true DC IR level and tells a steady illuminator apart from a flickering mains lamp. Honest about which sources each mode can and cannot see.",
)
