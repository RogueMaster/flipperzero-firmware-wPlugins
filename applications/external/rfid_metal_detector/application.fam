App(
    appid="rfid_metal_detector",
    name="RFID Metal Detector",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="metal_detector_app",
    targets=["f7"],
    stack_size=2 * 1024,
    fap_icon="nail_icon.png",
    sources=["src/*.c"],
    fap_category="RFID",
    fap_author="hnsvrdmn",
    fap_weburl="https://github.com/hnsvrdmn/flipper-rfid-metal-detector",
    fap_version="1.0",
    fap_description="A Flipper Zero application that repurposes the 125kHz RFID antenna to act as a makeshift metal detector.",
)
