App(
    appid="flipcraft",
    name="Flipcraft",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipcraft_app",
    sources=[
        "main.cpp",
        "platform/f7fz/platform.cpp",
        "menu/menu.cpp",
        "game/game.cpp",
        "game/data.cpp",
        "game/world.cpp",
        "render/render.cpp",
        "render/gui.cpp",
    ],
    stack_size=8 * 1024,
    fap_file_assets="assets/worlds",
    fap_icon="assets/icon.png",
    fap_category="Games",
    fap_author="apfxtech",
    fap_weburl="https://github.com/apfxtech/Flipcraft",
    fap_version="2.2",
    fap_description="Big world crafting game for Flipper Zero.",
)
