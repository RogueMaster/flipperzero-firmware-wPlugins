App(
    appid="staff_timeclock",
    name="Staff Time Clock",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="timeclock_app",
    stack_size=4 * 1024,
    fap_icon="timeclock_10px.png",
    fap_category="Tools",
    fap_author="Vladyslav Pereverzyev",
    fap_weburl="https://github.com/vladpereverzyev/flipper-staff-time-clock",
    fap_version="2.16",
    fap_description="Staff time-clock for Flipper Zero (official and custom firmwares): register collaborators on NFC, RFID or iButton badges and log clock in/out to a CSV timesheet. Left/Right picks which technology is active, and any existing card works - even one from another company - since only the UID is read. Identification only: no badge emulation, no authentication bypass.",
)
