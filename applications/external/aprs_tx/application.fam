App(
    appid="aprstx",
    name="APRS TX",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="flipperham_app",
    sources=[
        "app.c",
        "src/flipperham.c",
        "src/positions.c",
        "src/callbook.c",
        "src/cw.c",
        "src/ham_calls.c",
        "src/packet.c",
        "src/aprs.c",
        "src/rf_gen.c",
        "src/ui/ui.c",
        "src/ui/ui_freq.c",
        "src/ui/ui_edit.c",
        "src/ui/ui_splash.c",
        "src/ui/ui_runtime.c",
    ],
    stack_size=2 * 1024,
    fap_icon="flipperham.png",
    fap_category="Sub-GHz",
    fap_author="yo3gnd",
    fap_weburl="https://github.com/yo3gnd/flipper-zero-aprs-tx/",
    fap_version="1.3.18",
    fap_description="An APRS transmitter using Flipper Zero's SubGHZ module exclusively",
)
