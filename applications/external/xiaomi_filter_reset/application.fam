        "xiaomi_filter_reset.c",
        "scenes/*.c",
        "src/**/*.c",
    ],
    fap_category="NFC",
    fap_version="1.0",
    fap_author="khmm12",
    fap_weburl="https://github.com/khmm12/flipper-xiaomi-filter-reset",
    fap_description="Reset or check the filter-life counter on Xiaomi air purifier NFC filters.",
)
