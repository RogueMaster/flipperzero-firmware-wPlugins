App(
    appid="pingequa_rf_toolkit",
    name="PINGEQUA RF Lab",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pingequa_rf_toolkit_app",
    stack_size=4 * 1024,
    sources=[
        "pingequa_app.c",
        "core/*.c",
        "scenes/*.c",
        "views/*.c",
    ],
    fap_icon="icon.png",
    fap_category="GPIO",
    fap_author="PINGEQUA RF Toolkit",
    fap_weburl="https://github.com/pingequalab/rf-lab",
    fap_version="0.5.4",
    fap_description="2.4 GHz scanner + CW signal generator + CSV export + session log + settings persistence",
    # Phase 1.0 :Core / Scenes / Views fap_private_libs.
    # Phase 1.2 NRF24 Jammer + main_menu(13 Phase 5).
    # v0.4.0  RPD BLE + WiFi pilot-aware OFDM(Clancy 2011 + Brauer 2016).
    # v0.5.0  Scanner OK hits CSV / Jammer
    #         session / Settings jammer.
    # v0.5.2 RTC(scan_<date>_<time>_chNN /
    #         jam_<date>_<time>_<mode>_<dur>s)+ Jammer log
    #         About+QR / GitHub+QR / Legal).
    # v0.5.3 rebrand Jammer - Signal Generator;
    #         jammer-siggen,jammer.conf-siggen.conf.
    # v0.5.4 flush FIFO + set_tx_mode;
    #         +20dBm/OFDM
)
