App(
    appid="bible_bsb",
    name="Bible [BSB]",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    fap_icon="icon.png",
    fap_file_assets="assets",
    entry_point="bible_bsb_main",
    stack_size=8 * 1024,
    sources=["*.c"],
    fap_category="Media",
    fap_author="dpshde",
    fap_weburl="https://github.com/dpshde/bible-bsb",
    fap_version="1.2",
    fap_description="Browse and save BSB scripture passages with route.bible NFC sharing",
)
