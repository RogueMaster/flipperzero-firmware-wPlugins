App(
    appid="fmtx",
    name="FM TX",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="flipper_zero_fmtx_app",
    stack_size=4 * 1024,
    sources=["src/*.c"],
    fap_private_libs=[
        Lib(name="fmtx_vfo"),
    ],
    fap_file_assets="assets/fap",
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_author="yo3gnd",
    fap_weburl="https://github.com/yo3gnd/fmtx",
    fap_version="0.0.10",
    fap_description="Experimental MP3 audio over CC1101 FM.",
)
