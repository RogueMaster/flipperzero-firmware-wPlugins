App(
    appid="beepback",
    name="BEEPBACK",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="beepback_app",
    requires=["gui", "notification", "storage"],
    sources=[
        "beepback_app.c",  # the only file that talks to the device
        "beepback_nav.c",  # input, the browser's press()
        "beepback_tables.c",  # every table the browser build defines
        "beepback_game.c",  # runs, from start to game over
        "beepback_rules.c",  # the seven rules and the score maths
        "beepback_draw.c",  # every screen
        "beepback_intro.c",  # the splash
        "beepback_save.c",  # the save file
        "beepback_led.c",  # the five button colours
    ],
    stack_size=4 * 1024,
    fap_category="Games",
    fap_icon="beepback_10px.png",
    fap_author="Tijnv50",
    fap_version="1.0",
    fap_description="Simon-style memory game: five modes, changing rules, and a daily run every Flipper in the world plays the same.",
    fap_weburl="https://github.com/h4sw5q2wr9-byte/BEEPBACK",
)
