App(
    appid="seader",
    name="Seader",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="seader_app",
    stack_size=3 * 1024,
    cdefines=[
        "APP_SEADER",
        "ASN_DISABLE_PER_SUPPORT",
        "ASN_DISABLE_OER_SUPPORT",
        "ASN_DISABLE_XER_SUPPORT",
        "ASN_DISABLE_RANDOM_FILL",
    ],
    sources=[
        "*.c",
        "aeabi_uldivmod.sx",
        "!hf_interface_fal/*.c",
        "!runtime_policy.c",
        "!wiegand_interface_fal/*.c",
    ],
    fap_icon="icons/logo.png",
    fap_category="NFC",
    #    fap_extbuild=(
    #        ExtFile(
    #            path="${FAP_SRC_DIR}/lib/asn1/asn_system.h",
    #            command="asn1c -D ${FAP_SRC_DIR}/lib/asn1 -no-gen-example -pdu=all ${FAP_SRC_DIR}/seader.asn1"
    #        ),
    #    ),
    fap_libs=["mbedtls"],
    fap_private_libs=[
        Lib(
            name="asn1",
            cflags=[
                "-Wno-error",
                "-DASN_EMIT_DEBUG=0",
                "-DASN_DISABLE_PER_SUPPORT",
                "-DASN_DISABLE_OER_SUPPORT",
                "-DASN_DISABLE_XER_SUPPORT",
                "-DASN_DISABLE_RANDOM_FILL",
                "-Os",
            ],
        ),
        Lib(
            name="loclass",
            cflags=["-O3"],
        ),
    ],
    fap_icon_assets="icons",
    fap_icon_assets_symbol="seader",
    fap_author="bettse",
    # fap_weburl="https://seader.ericbetts.dev",
    fap_weburl="https://github.com/bettse/seader/",
    fap_version="4.0",
    fap_description="Interface with a SAM from the Flipper Zero over UART",
)

App(
    appid="seader_plugin_wiegand",
    apptype=FlipperAppType.PLUGIN,
    entry_point="plugin_wiegand_ep",
    requires=["seader"],
    sources=["wiegand_interface_fal/wiegand.c"],
    fal_embedded=True,
)

App(
    appid="seader_plugin_hf",
    apptype=FlipperAppType.PLUGIN,
    entry_point="plugin_hf_ep",
    requires=["seader"],
    sources=["hf_interface_fal/hf.c"],
    fal_embedded=True,
)
