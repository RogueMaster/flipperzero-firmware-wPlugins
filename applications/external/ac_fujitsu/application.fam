# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="ac_fujitsu_general_indoor_ir_remote",  # Must be unique
    name="AC Fujitsu General Remote",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    fap_version="1.0",
    entry_point="fujitsu_general_remote_app",
    stack_size=3 * 1024,
    fap_category="Infrared",
    fap_icon="fujitsu_general_remote.png",  # 10x10 1-bit PNG
    fap_description="Remote Control for Indoor AC Fujitsu General ASHG12KPCE. Check the details for compatibillity with other ACs",
    fap_author="Z. Nikolov",
    fap_weburl="https://github.com/j-stud-res/flipper-ac-fujitsu-general-remote",
    fap_icon_assets="images",  # Image assets to compile for this application
)
