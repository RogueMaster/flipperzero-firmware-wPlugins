        "views/fidget_view.c",
        "datarecord.c",
        "driver/ICM42688P.c",
    ],
    fap_category="Tools",
    fap_author="FliPort",
    fap_weburl="https://github.com/TheRealLuro/Flipper-zero-drop-detector.-",
    fap_version="0.3",
    fap_description="IMU drop / idle / walking / fidget sample collector for training a Flipper-side motion classifier.",
)
