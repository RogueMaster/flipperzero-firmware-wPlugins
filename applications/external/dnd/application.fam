# Suite release label. FAP's binary manifest stores numeric major/minor only.
DND_RELEASE_VERSION = "4.20.0"
DND_FAP_VERSION = (4, 20)
DND_RELEASE_DEFINES = [("DND_RELEASE_VERSION", '\\"' + DND_RELEASE_VERSION + '\\"')]

App(
    appid="dndolphins",
    name="DNDolphins",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="dndolphins_app",
    stack_size=6 * 1024,
    flags=["UnloadAssetPacks"],
    sources=[
        "dnd_character_collections.c",
        "dnd_data.c",
        "dnd_extra_items.c",
        "dnd_profile_handoff.c",
        "dnd_rules_core.c",
        "dnd_settings.c",
        "dnd_storage.c",
        "dnd_app_core.c",
        "dnd_app_hub_entry.c",
        "dndolphins_dice.c",
        "dndolphins_menu_graphics.c",
        "dndolphins_progression_store.c",
        "dndolphins_rules_character.c",
        "dndolphins_spells.c",
        "dndolphins_splash.c",
    ],
    fap_icon="icon.png",
    fap_icon_assets="dndolphins_images",
    fap_file_assets="character_assets",
    fap_category="Games",
    fap_author="RogueMaster",
    fap_weburl="https://github.com/RogueMaster/Dungeons_and_Dolphins",
    fap_version=DND_FAP_VERSION,
    cdefines=DND_RELEASE_DEFINES + [("DND_BUILD_HUB", "1")],
    fap_description="Offline 5E-compatible character, progression, dice, and companion-app hub.",
)


App(
    appid="dndcharactersheet",
