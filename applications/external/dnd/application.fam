    stack_size=6 * 1024,
    flags=["UnloadAssetPacks"],
    sources=[
        "dndolphins.c",
        "dnd_handoff.c",
        "dndolphins_data.c",
        "dndolphins_rules.c",
        "dndolphins_items.c",
        "dndolphins_spells.c",
        "dndolphins_spell_combat.c",
        "dndolphins_storage.c",
    ],
    fap_icon="icon.png",
    fap_file_assets="character_assets",
    fap_category="Games",
    fap_author="RogueMaster",
    fap_weburl="https://github.com/RogueMaster/Dungeons_and_Dolphins",
    fap_version="3.2.31",
    fap_description="Offline 5E-compatible character, spells, inventory, dice, and combat hub.",
)


