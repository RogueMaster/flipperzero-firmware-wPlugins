App(
    appid="sub_counter",
    name="Subscriber Counter",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="sub_counter_main",
    stack_size=4 * 1024,
    sources=[
        "subscriber_counter.c",
        "yt_parse.c",
        "yt_fonts.c",
        "yt_wifi.c",
        "vendor/internet_bridge/*.c",
        "vendor/internet_bridge/sdk/flipper/*.c",
        "vendor/flipper_http/*.c",
    ],
    fap_icon="icon.png",
    fap_category="Tools",
    fap_author="TheProductAgency",
    fap_weburl="https://github.com/TheProductAgency/flipper-subscriber-counter",
    fap_version="1.3",
    fap_description="Live YouTube subscriber count via Internet Bridge or Wi-Fi board",
)
