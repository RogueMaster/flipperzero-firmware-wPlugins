App(
    appid="seos",
    name="Seos compatible",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="seos_app",
    stack_size=10 * 1024,
    fap_icon="seos.png",
    fap_icon_assets="images",
    fap_file_assets="files",
    fap_libs=["mbedtls"],
    sources=["*.c*", "!lib", "!ble_ext_fal", "!ble_native_fal", "!ble_shared"],
    fap_category="NFC",
    fap_author="bettse",
    fap_weburl="https://github.com/bettse/seos_compatible",
    fap_version="1.3",
    fap_description="Seos compatible reader/emulator",
)

# The BLE stacks are most of the image and most sessions never use one, so
# they load on demand. fal_embedded ships them inside the .fap.
App(
    appid="plugin_ble_ext",
    apptype=FlipperAppType.PLUGIN,
    entry_point="plugin_ble_ext_ep",
    requires=["seos"],
    sources=["ble_ext_fal/*.c", "ble_shared/*.c"],
    fal_embedded=True,
)

App(
    appid="plugin_ble_native",
    apptype=FlipperAppType.PLUGIN,
    entry_point="plugin_ble_native_ep",
    requires=["seos"],
    sources=["ble_native_fal/*.c", "ble_shared/*.c"],
    fal_embedded=True,
)
