#
# config.h owns the dependency rules between configuration macros. CMake
# compiles config.h with the registered definitions, so CMake and
# direct-source builds accept the same configurations.

# Compile config.h under definitions (a list of MACRO=value) and fail
# configuration with its #error text when it rejects them.
function(tc_check_config definitions)
  # Skip the compile when the compiler, definitions and rule headers are unchanged.
  file(SHA256 "${PROJECT_SOURCE_DIR}/src/tiny_crypto/config.h" config_hash)
  file(SHA256 "${PROJECT_SOURCE_DIR}/src/tiny_crypto/resource_profile.h" profile_hash)
  string(SHA256 key
    "${CMAKE_C_COMPILER};${CMAKE_C_FLAGS};${config_hash};${profile_hash};${definitions}")
  if(TC_CONFIG_CHECK_PASSED STREQUAL key)
    return()
  endif()

  set(directory "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/tc_config_check")
  set(source "${directory}/config_check.c")
  file(WRITE "${source}" "#include <tiny_crypto/config.h>\nint tc_config_check;\n")
  set(flags)
  foreach(definition IN LISTS definitions)
    list(APPEND flags "-D${definition}")
  endforeach()
  # Compile only. Cross toolchains need no runnable or linkable program.
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  try_compile(accepted "${directory}/build" SOURCES "${source}"
    COMPILE_DEFINITIONS ${flags}
    CMAKE_FLAGS "-DINCLUDE_DIRECTORIES=${PROJECT_SOURCE_DIR}/src"
    C_STANDARD 99
    OUTPUT_VARIABLE output)
  if(accepted)
    set(TC_CONFIG_CHECK_PASSED "${key}" CACHE INTERNAL "Accepted configuration")
    return()
  endif()
  unset(TC_CONFIG_CHECK_PASSED CACHE)

  # GCC and Clang print `error: #error "text"` or `error: "text"`. MSVC prints
  # `error C1189: #error:  "text"`. Clang also echoes the source line.
  set(pattern "error:? +(#error:? +)?\"([^\"\r\n]+)\"")
  string(REGEX MATCHALL "${pattern}" matches "${output}")
  set(reasons)
  foreach(match IN LISTS matches)
    string(REGEX REPLACE "^${pattern}$" "\\2" reason "${match}")
    list(APPEND reasons "${reason}")
  endforeach()
  list(REMOVE_DUPLICATES reasons)
  if(NOT reasons)
    message(FATAL_ERROR "config.h rejected the selected options:\n${output}")
  endif()
  list(JOIN reasons "\n  " text)
  message(FATAL_ERROR "The selected options violate config.h:\n  ${text}")
endfunction()

# Write build_config.h for installation. config.h includes it twice. The first
# pass defines every registered macro that the consumer left undefined, using
# the value the archive was built with. The second pass, at the end of config.h,
# runs with TC_BUILD_CONFIG_VERIFY defined and rejects a consumer definition
# with a different value. Symbolic values such as TC_RESOURCE_MICRO are defined
# by then. The source tree's build_config.h stays empty.
function(tc_write_build_config output definitions)
  set(defaults)
  set(checks)
  foreach(definition IN LISTS definitions)
    if(NOT definition MATCHES "^(TC_[A-Z0-9_]+)=([0-9]+)$")
      message(FATAL_ERROR "Public definition ${definition} is not MACRO=number")
    endif()
    set(macro ${CMAKE_MATCH_1})
    set(value ${CMAKE_MATCH_2})
    string(APPEND defaults "#ifndef ${macro}\n#define ${macro} ${value}\n#endif\n")
    string(APPEND checks "#if ${macro} != ${value}\n")
    string(APPEND checks "#error \"${macro} differs from the installed library configuration\"\n")
    string(APPEND checks "#endif\n")
  endforeach()
  set(content "/* Generated by tiny_crypto_c CMake. Do not edit. */\n")
  string(APPEND content "#ifndef TC_BUILD_CONFIG_VERIFY\n")
  string(APPEND content "#ifndef TINY_CRYPTO_BUILD_CONFIG_H_\n")
  string(APPEND content "#define TINY_CRYPTO_BUILD_CONFIG_H_\n")
  string(APPEND content "${defaults}")
  string(APPEND content "#endif\n")
  string(APPEND content "#else\n")
  string(APPEND content "${checks}")
  string(APPEND content "#endif\n")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()
