{
  "name": "tiny_crypto_c",
  "version": "2.0.0",
  "description":
      "Provides AES, DES/3DES, SHA-1/SHA-2, HMAC/CMAC/KMAC, KBKDF/HKDF/SSKDF, DRBG, RSA/ECDSA/ECDH, X.509/CMS/OCSP, and PIV/TWIC/APDU validation with caller-owned storage and secret-state wiping",
  "keywords":
      "cryptography,aes,des,sha1,sha2,hmac,cmac,kmac,kdf,kbkdf,hkdf,drbg,rsa,ecdsa,ecdh,x509,cms,piv,twic,embedded",
  "repository": {
    "type": "git",
    "url": "https://github.com/mistial-dev/tiny_crypto_c.git"
  },
  "license": "GPL-2.0-or-later",
  "frameworks": "*",
  "platforms": "*",
  "examples": [
    "examples/AESCTR/AESCTR.ino",
    "examples/SHA256/SHA256.ino"
  ],
  "export": {
    "include": [
      "src/*",
      "examples/AESCTR/*",
      "examples/SHA256/*",
      "library.json",
      "library.properties",
      "LICENSE",
      "LICENSES/*",
      "README.md"
    ]
  }
}
