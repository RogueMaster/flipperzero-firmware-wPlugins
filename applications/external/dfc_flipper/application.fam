App(
    appid="dfc",
    name="DFC",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="dfc_app",
    stack_size=10 * 1024,
    fap_icon="dfc.png",
    fap_icon_assets="images",
    fap_file_assets="files",
    cdefines=[
        ("AES128", "1"),
        ("AES192", "0"),
        ("AES256", "0"),
        ("AES_ENABLE_CBC", "1"),
        ("AES_ENABLE_CTR", "0"),
        ("DES_ENABLE_ECB", "1"),
        ("DES_ENABLE_CBC", "1"),
        ("DES_ENABLE_CTR", "0"),
        ("DES_ENABLE_TDES", "1"),
        ("DFC_FIRMWARE_BUILD", "1"),
        ("DFC_BUILD_PROFILE", "DFC_PROFILE_FULL_EV1"),
    ],
    fap_private_libs=[
        Lib(
            name="core",
            fap_include_paths=["src", "port"],
            sources=["src/*.c"],
            cincludes=["lib/tiny_AES_c", "lib/tiny_DES_c"],
        ),
        Lib(
            name="tiny_AES_c",
            fap_include_paths=["."],
            sources=["aes.c"],
        ),
        Lib(
            name="tiny_DES_c",
            fap_include_paths=["."],
            sources=["des.c"],
        ),
    ],
    sources=["*.c", "*.cpp", "!lib"],
    fap_category="NFC",
    fap_author="CinderSocket",
    fap_weburl="https://github.com/cindersocket/dfc-flipper",
    fap_version="1.0",
    fap_description="DFC: reader/emulator for compatible NFC credentials",
)
