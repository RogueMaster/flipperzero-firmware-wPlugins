App(
    appid="password_keyboard",
    name="Password Keyboard",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="password_keyboard_app",
    stack_size=4 * 1024,
    sources=["password_keyboard.c", "zk_crypto.c", "zk_settings.c", "zk_vault.c"],
    fap_icon="password_keyboard_10px.png",
    fap_libs=["ble_profile"],
    fap_category="Bluetooth",
    fap_author="Evgeniy Raev",
    fap_weburl="https://github.com/evgeniyraev/password_keyboard",
    fap_version="0.1",
    fap_description="A BLE password keyboard with concealed daily-limited passwords",
)
