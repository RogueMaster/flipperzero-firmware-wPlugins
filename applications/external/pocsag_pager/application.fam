App(
    appid="pocsag_pager",
    name="POCSAG Pager",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="pocsag_pager_app",
    stack_size=4 * 1024,
    fap_icon="pocsag_pager_10px.png",
    fap_icon_assets="images",
    fap_icon_assets_symbol="pocsag_pager",
    sources=[
        "*.c",
        "!plugins",
    ],
    fap_category="Sub-GHz",
    fap_author="xMasterX & Shmuma",
    fap_weburl="https://github.com/xMasterX/flipper-pager",
    fap_version="2.0",
    fap_description="Receive and transmit POCSAG 512/1200/2400 messages on CC1101 supported frequencies.",
)

App(
    appid="pocsag_pager_send",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="pocsag_pager_send_plugin_ep",
    requires=["pocsag_pager"],
    fap_icon_assets="plugins/images",
    fal_embedded=True,
    sources=[
        "plugins/*.c",
    ],
)
