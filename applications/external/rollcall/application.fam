App(
    appid="rollcall",
    name="RollCall",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="rollcall_app",
    stack_size=4 * 1024,
    fap_icon="icons/rollcall_10px.png",
    fap_icon_assets="icons",
    fap_category="Sub-GHz",
    fap_author="at0m-b0mb",
    fap_weburl="https://github.com/at0m-b0mb/RollCall-FlipperZero",
    fap_version="1.1",
    # Explicit, so the recursive default does not sweep test/ (host-only code,
    # stubbed HAL) into the firmware build.
    sources=[
        "rollcall.c",
        "helpers/*.c",
        "views/*.c",
        "scenes/*.c",
    ],
    fap_description="Rolling-code health check for your own key fobs and garage/gate remotes. Press your remote a few times and RollCall decodes each press, tells you if the protocol is a rolling code or a static fixed OOK code, and confirms the code actually advances between presses. Read-only, non-destructive: it only listens and decodes, it never transmits, replays or clones. Know whether your remote resists replay before someone else finds out.",
)
