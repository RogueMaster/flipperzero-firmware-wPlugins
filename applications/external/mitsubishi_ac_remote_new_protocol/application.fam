App(
    appid="mitsubishi_ac_remote_new_protocol",
    name="Mitsubishi AC (New)",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="ac_remote_app",
    cdefines=["APP_MITSUBISHI_AC_REMOTE"],
    stack_size=1 * 2048,
    fap_icon="ac_remote.png",
    fap_icon_assets="assets",
    fap_private_libs=[
        Lib(
            name="hvac_mitsubishi",
            sources=[
                "hvac_mitsubishi.c",
            ],
        ),
    ],
    fap_category="Infrared",
    fap_author="Str4ch",
    fap_weburl="https://github.com/Str4ch/flipperzero-mitsubishi-ac-remote-new-protocol",
    fap_version="1.0",
    fap_description="Mitsubishi Air Conditioner remote control(New)",
)
