App(
    appid="osm_logger",
    name="OSM Logger GPS",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="osm_logger_app",
    stack_size=4 * 1024,
    fap_icon="osm_logger.png",
    fap_icon_assets="images",
    sources=[
        "src/osm_logger.c",
        "src/app.c",
        "src/nmea.c",
        "src/quick_log.c",
        "src/track.c",
        "src/status.c",
        "src/about.c",
        "src/settings.c",
        "src/last_points.c",
        "src/point_detail.c",
        "src/notes_cache.c",
        "src/storage.c",
        "src/presets.c",
    ],
    fap_category="GPIO",
    fap_author="Simon Grossi",
    fap_weburl="https://github.com/simongrossi/flipperzero-osm-logger-gps",
    fap_version=(0, 15),
    fap_description="Log OSM POIs (bench, bin, fountain...) in the field with a NEO-6M GPS. Saves JSONL, CSV, GPX and GeoJSON on microSD.",
)
