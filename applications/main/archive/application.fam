App(
    appid="archive",
    name="Archive",
    apptype=FlipperAppType.ARCHIVE,
    entry_point="archive_launcher_app",
    cdefines=["APP_ARCHIVE"],
    requires=["gui"],
    stack_size=6 * 1024,
    order=10,
    sources=[
        "archive_launcher.c",
        "helpers/archive_launch.c",
        "helpers/archive_apps.c",
        "helpers/archive_files.c",
        "helpers/archive_favorites.c",
        "helpers/favorite_timeout.c",
    ],
    sdk_headers=[
        "helpers/archive_helpers_ext.h",
    ],
)

App(
    appid="archive_browser",
    name="Archive",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="archive_app",
    cdefines=["APP_ARCHIVE_BROWSER"],
    requires=["gui"],
    stack_size=6 * 1024,
    sources=[
        "archive.c",
        "helpers/archive_launch.c",
        "helpers/archive_apps.c",
        "helpers/archive_browser.c",
        "helpers/archive_files.c",
        "helpers/archive_favorites.c",
        "scenes/*.c",
        "views/*.c",
    ],
    fap_category="Main",
    fap_icon="archive_10px.png",
    fap_version="1.0",
)
