# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="flipper_share_ir",
    name="Flipper Share IR",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ir_share_app",
    stack_size=2 * 1024,
    fap_category="Infrared",
    # Optional values
    fap_version="1.5",
    fap_icon="ir_share.png",  # 10x10 1-bit PNG
    fap_description="Direct file transfer between flippers via IR",
    fap_author="@lomalkin",
    fap_weburl="https://github.com/lomalkin/flipper-zero-apps/blob/-/flipper_share_ir",
    # fap_icon_assets="images",  # Image assets to compile for this application
)
