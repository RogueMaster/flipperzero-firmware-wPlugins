# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="flipper_share_nfc",
    name="Flipper Share NFC",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nfc_share_app",
    stack_size=2 * 1024,
    fap_category="NFC",
    # Optional values
    fap_version="1.5",
    fap_icon="nfc_share.png",  # 10x10 1-bit PNG
    fap_description="Direct file transfer between flippers via NFC",
    fap_author="@lomalkin",
    fap_weburl="https://github.com/lomalkin/flipper-zero-apps/blob/-/flipper_share_nfc",
    # fap_icon_assets="images",  # Image assets to compile for this application
)
